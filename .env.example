# ---------------------------------------------------------------
# PUBLIC frontend variables (bundled into the site, safe to expose)
# Set these in .env.local for development and as GitHub repository
# secrets/variables for the Pages build.
# ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# SERVER-ONLY secrets. NEVER prefix with VITE_ and never commit.
# Store these as Supabase Edge Function secrets:
#   supabase secrets set --env-file supabase/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge
# Functions automatically; they are listed here for reference only.)
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=
APP_BASE_URL=
# Long random string (openssl rand -hex 32). Used to hash secure IDs and
# encrypt tracking tokens. Changing it invalidates all existing secure IDs.
SERVER_SECRET=
